# Copy this file to .env, then restart the app.

# Real prices. Requires a DataFluxor FUT Data subscription.
PRICE_PROVIDER=datafluxor
DATAFLUXOR_API_KEY=

# Free fixed sample data. Remove the key above and uncomment this line.
# DATAFLUXOR_SANDBOX=1

# Two minutes keeps usage well inside the smallest plan.
POLL_SECONDS=120
